ded by a thin chain, while tiny fireflies hover around her feet, illuminating dust motes dancing in the air. Her expression carries quiet wonder mixed with playful innocence, bathed in warm, diffused light filtering through mossy ferns below. The entire scene exudes a dreamlike, ethereal quality — reminiscent of vintage illustration meets modern fantasy art — rendered with painterly textures, rich saturation, and subtle depth-of-field blur for atmospheric immersion."]},{"id":15,"type":"easy saveText","pos":[-109.4670495737414,1436.5818904296948],"size":[270,150],"flags":{},"order":7,"mode":4,"inputs":[{"label":"文本","localized_name":"text","name":"text","type":"STRING","link":13},{"label":"image","localized_name":"图像","name":"image","shape":7,"type":"IMAGE"},{"label":"output_file_path","localized_name":"输出文件路径","name":"output_file_path","type":"STRING","widget":{"name":"output_file_path"}},{"label":"file_name","localized_name":"文件名","name":"file_name","type":"STRING","widget":{"name":"file_name"}},{"label":"file_extension","localized_name":"文件扩展名","name":"file_extension","type":"COMBO","widget":{"name":"file_extension"}},{"label":"overwrite","localized_name":"覆盖","name":"overwrite","type":"BOOLEAN","widget":{"name":"overwrite"}}],"outputs":[{"label":"文本","localized_name":"text","name":"text","type":"STRING"},{"label":"图像","localized_name":"image","name":"image","type":"IMAGE"}],"title":"输出=文本","properties":{"cnr_id":"comfyui-easy-use","ver":"e900c2ca9c0d90b0896881910ca7f3f02d88ebd8","Node name for S&R":"easy saveText","ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["output/软件/文本","文本","txt",true]}],"links":[[2,3,0,2,3,"STRING"],[13,6,0,15,0,"STRING"],[19,11,0,2,2,"STRING"],[26,2,0,21,2,"STRING"],[27,8,0,21,10,"INT"],[28,21,0,6,0,"STRING"]],"groups":[{"id":1,"title":"提示词","bounding":[-1167.5999755859375,467.12640380859375,1448.3363037109375,1495.9140625],"color":"#8A8","font_size":48,"flags":{}}],"config":{